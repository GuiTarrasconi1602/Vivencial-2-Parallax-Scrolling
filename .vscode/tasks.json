{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++",
      "args": [
        "main.cpp",
        "-o", "app.exe",

        "-Ilibs/include",
        "-Llibs/lib",

        "-lglfw3",
        "-lglew32",
        "-lopengl32",
        "-lgdi32"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}